  <artifactId>ddf-common-mqtt</artifactId>
  <version>boot3.5-2026.1-SNAPSHOT</version>
  <name>ddf-common-mqtt</name>
  <description>MQTT client integration module with publishing and connection support.</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <properties>
