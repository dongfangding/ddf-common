{
    "env": {
        "PROJECT_ROOT": "."
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph update --skip-flows --repo \"${PROJECT_ROOT}\" || true",
                        "timeout": 30
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status --repo \"${PROJECT_ROOT}\" || echo 'Not a git repo, skipping'",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
